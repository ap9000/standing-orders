{
  "name": "standing-orders",
  "version": "0.4.1",
  "description": "A control plane for unattended coding agents — queue tasks, walk away, come back to pull requests. Agents build in leased worktrees, never touch your default branch, and interrupt you only for decisions that need a human.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ap9000/standing-orders.git"
  },
  "keywords": [
    "agents",
    "orchestration",
    "claude-code",
    "codex",
    "git-worktree",
    "ai-agents",
    "autonomous-agents",
    "agent-orchestration",
    "control-plane",
    "cli",
    "task-queue",
    "llm",
    "openrouter",
    "telegram",
    "unattended"
  ],
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ap9000/standing-orders/issues"
  },
  "homepage": "https://github.com/ap9000/standing-orders#readme",
  "bin": {
    "standing-orders": "dist/bin.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "happy-dom": "^20.12.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist"
  ]
}
