{
  "name": "standing-orders",
  "version": "0.4.3",
  "description": "A control plane for unattended coding agents \u2014 queue tasks, walk away, come back to pull requests. Agents build in leased worktrees, never touch your default branch, and interrupt you only for decisions that need a human.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "certify:provider": "npm run build && node scripts/provider-canary.mjs",
    "certify:recovery": "npm run build && node scripts/recovery-canary.mjs",
    "certify:crash": "npm run build && node scripts/crash-canary.mjs",
    "certify:pilot": "npm run build && node scripts/pilot.mjs",
    "prepublishOnly": "npm run typecheck && npm run build",
    "nul-scan": "node scripts/nul-scan.mjs",
    "proof-preflight": "node scripts/proof-preflight.mjs",
    "fixture:v47": "node scripts/derive-v47-fixture.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "certify:restart": "npm run build && node scripts/restart-certification.mjs",
    "certify:launchd": "npm run build && node scripts/launchd-certification.mjs",
    "test:native-containment": "vitest run src/containment-native.test.ts src/containment.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ap9000/standing-orders.git"
  },
  "keywords": [
    "agents",
    "orchestration",
    "claude-code",
    "codex",
    "git-worktree",
    "ai-agents",
    "autonomous-agents",
    "agent-orchestration",
    "control-plane",
    "cli",
    "task-queue",
    "llm",
    "openrouter",
    "telegram",
    "unattended"
  ],
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ap9000/standing-orders/issues"
  },
  "homepage": "https://github.com/ap9000/standing-orders#readme",
  "bin": {
    "standing-orders": "dist/bin.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "happy-dom": "^20.12.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist",
    "scripts/provider-canary.mjs",
    "scripts/canary-assertions.mjs",
    "scripts/recovery-canary.mjs",
    "scripts/crash-canary.mjs",
    "scripts/fixtures/crash-process.mjs",
    "scripts/pilot.mjs",
    "scripts/fixtures/pilot-scenarios.mjs",
    "scripts/proof-preflight.mjs",
    "scripts/restart-certification.mjs",
    "scripts/launchd-certification.mjs",
    "scripts/fixtures/restart-service.mjs"
  ]
}
