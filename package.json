{
  "name": "standing-orders",
  "version": "0.1.1",
  "description": "The control plane for coding agents you can safely leave alone — queue tasks, walk away, come back to pull requests. Standing orders for your agents: wake me only for these.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ap9000/standing-orders.git"
  },
  "keywords": [
    "agents",
    "orchestration",
    "claude-code",
    "codex",
    "git-worktree",
    "ai-agents",
    "autonomous-agents",
    "agent-orchestration",
    "control-plane",
    "cli",
    "task-queue",
    "llm",
    "openrouter",
    "telegram",
    "unattended"
  ],
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ap9000/standing-orders/issues"
  },
  "homepage": "https://github.com/ap9000/standing-orders#readme",
  "bin": {
    "standing-orders": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist"
  ]
}
