{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ap9000/toolroll/docs/flow-file.schema.json",
  "title": "Toolroll flow file",
  "description": "A flow exported from Toolroll (*.toolroll-flow.json): its zones in the lead's step vocabulary, its triggers' settings and the scripts it runs. Never secrets, webhook addresses or hashes, tokens, people's names, chat bindings or cards. {{param.<id>}} in a zone or trigger is replaced by the value the import asks for. Toolroll reads files up to 256 KB and checks every zone, trigger and script again on import (src/flow-share.ts).",
  "type": "object",
  "required": ["format", "version", "name", "zones"],
  "properties": {
    "format": { "const": "toolroll-flow" },
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "about": { "type": "string", "maxLength": 600, "description": "One line on what the flow does. Untrusted: shown in the import preview." },
    "needs": {
      "type": "array", "maxItems": 40,
      "description": "What the flow needs to run: github, linear, openrouter, email, tool:<server>, secret:<NAME>, teammate:<handle>, script:<name>.",
      "items": { "type": "string", "maxLength": 80 }
    },
    "parameters": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "required": ["id", "about"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
          "about": { "type": "string", "maxLength": 200, "description": "The question the import asks." },
          "default": { "type": "string", "maxLength": 200 },
          "optional": { "type": "boolean", "description": "May be left empty (the field is then left out)." }
        }
      }
    },
    "zones": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "$ref": "#/$defs/zone" }, "description": "The zones in order; the first is where cards start." },
    "triggers": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/trigger" } },
    "scripts": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/script" } }
  },
  "$defs": {
    "ref": { "type": "string", "maxLength": 60, "description": "Another zone, by its id (or its title)." },
    "duration": { "oneOf": [{ "type": "string", "description": "Like \"3 days\", \"4 hours\", \"90 minutes\"." }, { "type": "integer", "minimum": 1, "maximum": 43200, "description": "Minutes." }] },
    "zone": {
      "type": "object", "required": ["id", "title", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "kind": { "enum": ["inbox", "task", "report", "approval", "check", "pull-request", "update", "notify", "sort", "draft", "request", "email", "tool", "wait", "teammate", "done"] },
        "instructions": { "type": "string", "maxLength": 4000, "description": "task, report, draft, teammate: what the agent is asked. Fill-ins: {{card.title}}, {{card.description}}, {{card.email}}, {{note}}, {{stage.<id>}}. Untrusted on import." },
        "planning": { "enum": ["auto", "required", "skip"] },
        "decider": { "type": "string", "maxLength": 64, "description": "approval: owner, anyone, or a sign-in name (exported as a parameter)." },
        "message": { "type": "string", "maxLength": 1000 },
        "close": { "type": "boolean" },
        "script": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
        "runIn": { "enum": ["folder", "copy"] },
        "secrets": { "type": "array", "maxItems": 10, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,39}$" }, "description": "Names of saved secrets; never their values." },
        "routes": { "type": "array", "maxItems": 12, "items": { "type": "object", "required": ["answer", "goesTo"], "properties": { "answer": { "type": "string", "maxLength": 40 }, "goesTo": { "$ref": "#/$defs/ref" } } } },
        "question": { "type": "string", "maxLength": 300 },
        "answers": { "type": "array", "minItems": 2, "maxItems": 12, "items": { "type": "object", "required": ["answer", "goesTo"], "properties": { "answer": { "type": "string", "maxLength": 40 }, "means": { "type": "string", "maxLength": 200 }, "goesTo": { "$ref": "#/$defs/ref" } } } },
        "sureAt": { "type": "number", "minimum": 0.5, "maximum": 99, "description": "A percentage (80) or a fraction (0.8)." },
        "alsoNote": { "type": "array", "maxItems": 3, "items": { "type": "object", "required": ["question"], "properties": { "id": { "type": "string" }, "question": { "type": "string" }, "kind": { "enum": ["score", "yes-no"] }, "levels": { "type": "array", "items": { "type": "string" } } } } },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "url": { "type": "string", "maxLength": 2000 },
        "headers": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 500 }, "description": "Secrets ride as {{secret.NAME}}, never written out." },
        "body": { "type": "string", "maxLength": 8000 },
        "to": { "type": "string", "maxLength": 500 },
        "subject": { "type": "string", "maxLength": 200 },
        "server": { "type": "string", "maxLength": 64 },
        "tool": { "type": "string", "maxLength": 100 },
        "args": { "oneOf": [{ "type": "string" }, { "type": "object" }] },
        "waitFor": { "enum": ["reply", "time", "hours"] },
        "wait": { "$ref": "#/$defs/duration" },
        "from": { "type": "string", "pattern": "^[0-9]{1,2}:[0-9]{2}$" },
        "until": { "type": "string", "pattern": "^[0-9]{1,2}:[0-9]{2}$" },
        "timeZone": { "type": "string" },
        "merge": { "enum": ["squash", "merge", "rebase"] },
        "teammate": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
        "reply": { "type": "boolean" },
        "remindAfter": { "$ref": "#/$defs/duration" },
        "thenMoveTo": { "$ref": "#/$defs/ref" },
        "next": { "$ref": "#/$defs/ref" },
        "ifFails": { "$ref": "#/$defs/ref" },
        "ifNotSure": { "$ref": "#/$defs/ref" },
        "ifNoReply": { "$ref": "#/$defs/ref" },
        "at": {
          "type": "object", "description": "Where the zone sits on the canvas.",
          "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "w": { "type": "number" }, "h": { "type": "number" }, "color": { "enum": ["slate", "blue", "violet", "amber", "green", "rose"] } }
        }
      }
    },
    "trigger": {
      "type": "object", "required": ["kind"],
      "description": "A trigger's settings, as `toolroll flows trigger add` takes them. Imported switched off. Chat channel and other-flow triggers stay behind.",
      "properties": {
        "kind": { "enum": ["button", "schedule", "github", "linear", "webhook", "email", "plane-review"] },
        "zone": { "$ref": "#/$defs/ref" }
      }
    },
    "script": {
      "type": "object", "required": ["name", "about"],
      "description": "A project script a zone or schedule runs. Imported held until a person approves it.",
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
        "about": { "type": "string", "maxLength": 160 },
        "language": { "enum": ["shell", "python", "node"] },
        "timeoutMinutes": { "type": "integer", "minimum": 1, "maximum": 60 },
        "body": { "type": "string", "maxLength": 20000 },
        "file": { "type": "string", "maxLength": 200, "description": "A path inside the project, run instead of a body." }
      }
    }
  }
}
