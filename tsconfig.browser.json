{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node", "react", "react-dom"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/browser/**/*.ts", "src/browser/**/*.tsx"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
